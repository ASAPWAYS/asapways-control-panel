# The backend doesn't send CORS headers for localhost, so browser requests
# from the Vite dev server must go through its proxy (see vite.config.ts)
# rather than hitting the backend directly. Use a relative path here for
# local dev:
VITE_API_BASE_URL=/api/v1/admin

# In production (a real deployed origin, no dev-server proxy available),
# either point this at the backend directly once it allows your deployed
# origin via CORS, or configure your hosting platform to proxy /api/* to:
#   https://asapwaysbackend-production.up.railway.app
